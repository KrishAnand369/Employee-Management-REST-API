{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
    "name": "Employee Management REST API",
    "description": "Comprehensive Postman collection for Employee Management API technical assessment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "employeeId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jane.doe@company.com\",\n  \"department\": \"Engineering\",\n  \"position\": \"Senior Backend Engineer\",\n  \"salary\": 120000.00,\n  \"status\": \"ACTIVE\",\n  \"hireDate\": \"2024-01-15\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/employees",
          "host": ["{{baseUrl}}"],
          "path": ["employees"]
        }
      }
    },
    {
      "name": "Get All Employees (Paginated & Filtered)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/employees?page=0&size=10&sort=id,asc&department=Engineering&status=ACTIVE",
          "host": ["{{baseUrl}}"],
          "path": ["employees"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "10" },
            { "key": "sort", "value": "id,asc" },
            { "key": "department", "value": "Engineering" },
            { "key": "status", "value": "ACTIVE" },
            { "key": "search", "value": "jane", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "Get Employee by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/employees/{{employeeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["employees", "{{employeeId}}"]
        }
      }
    },
    {
      "name": "Update Employee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\",\n  \"email\": \"jane.smith@company.com\",\n  \"department\": \"Engineering\",\n  \"position\": \"Staff Engineer\",\n  \"salary\": 140000.00,\n  \"status\": \"ACTIVE\",\n  \"hireDate\": \"2024-01-15\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/employees/{{employeeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["employees", "{{employeeId}}"]
        }
      }
    },
    {
      "name": "Delete Employee",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/employees/{{employeeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["employees", "{{employeeId}}"]
        }
      }
    }
  ]
}
